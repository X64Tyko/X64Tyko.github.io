---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getPostsByArea } from '@/lib/posts';
import { overallScore, formatScore } from '@/lib/reviews';
import { trackById } from '@/data/tracks';

const track = trackById('games');
const posts = await getPostsByArea('games');

const reviews = (
  await getCollection('reviews', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = (
  await getCollection(
    'projects',
    ({ data }) => (import.meta.env.DEV || !data.draft) && data.area === 'games',
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={track.label} description={track.blurb}>
  <div class="container-prose">
    <header class="pb-8">
      <hr class="rule-gold mb-8" />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {track.label}
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-400">
        {track.blurb}
      </p>
      <p class="mt-4 text-sm">
        <a href="/games/rss.xml" class="text-accent-700 link-underline dark:text-accent-300">
          Games feed
        </a>
      </p>
    </header>

    <section class="border-t border-slate-200 pt-4 dark:border-slate-800">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Reviews
        </h2>
        {reviews.length > 0 && (
          <a href="/reviews/" class="text-sm text-accent-700 link-underline dark:text-accent-300">
            All reviews
          </a>
        )}
      </div>

      {reviews.length === 0 ? (
        <p class="py-8 text-slate-500 dark:text-slate-400">Nothing published yet.</p>
      ) : (
        <ul class="mt-2 divide-y divide-slate-200 dark:divide-slate-800">
          {reviews.slice(0, 5).map((review) => (
            <li class="group relative py-6">
              <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                <FormattedDate date={review.data.date} class="font-mono text-xs" />
                {review.data.genre && (
                  <span class="font-mono text-xs">{review.data.genre}</span>
                )}
              </div>

              <div class="mt-1 flex items-baseline justify-between gap-4">
                <h3 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100">
                  <a href={`/reviews/${review.id}/`} class="after:absolute after:inset-0">
                    <span class="bg-gradient-to-r from-gold-400 to-accent-400 bg-[length:0%_2px] bg-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_2px]">
                      {review.data.game}
                    </span>
                  </a>
                </h3>
                {overallScore(review.data) !== undefined && (
                  <span class="shrink-0 font-mono text-sm text-gold-700 dark:text-gold-400">
                    {formatScore(overallScore(review.data)!)}/10
                  </span>
                )}
              </div>

              <p class="mt-1 leading-relaxed text-slate-600 dark:text-slate-400">
                {review.data.verdict ?? review.data.description}
              </p>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="mt-10 border-t border-slate-200 pt-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Writing
      </h2>
      {posts.length === 0 ? (
        <p class="py-8 text-slate-500 dark:text-slate-400">
          Nothing here yet. Set <code class="font-mono text-sm">area: 'games'</code> on a
          post to file it under this track.
        </p>
      ) : (
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </section>

    {projects.length > 0 && (
      <section class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Projects
        </h2>
        <ul class="mt-4 space-y-3">
          {projects.map(({ data }) => (
            <li>
              <span class="font-medium text-slate-900 dark:text-slate-100">{data.name}</span>
              <span class="ml-2 font-mono text-xs text-slate-500 dark:text-slate-400">
                {data.status}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
