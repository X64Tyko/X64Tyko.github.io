---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPostsByArea } from '@/lib/posts';
import { trackById } from '@/data/tracks';

const track = trackById('industry');
const posts = await getPostsByArea('industry');
---

<BaseLayout title={track.label} description={track.blurb}>
  <div class="container-prose">
    <header class="pb-8">
      <hr class="rule-gold mb-8" />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {track.label}
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-400">
        {track.blurb}
      </p>
      <p class="mt-4 text-sm">
        <a href="/industry/rss.xml" class="text-accent-700 link-underline dark:text-accent-300">
          Industry feed
        </a>
      </p>
    </header>

    <section class="border-t border-slate-200 pt-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Writing
      </h2>
      {posts.length === 0 ? (
        <p class="py-8 text-slate-500 dark:text-slate-400">Nothing published yet.</p>
      ) : (
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
