---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getTags } from '@/lib/tags';

export const getStaticPaths = (async () => {
  const tags = await getTags();
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
---

<BaseLayout
  title={tag.name}
  description={`Everything tagged ${tag.name}.`}
>
  <div class="container-prose">
    <header class="pb-4">
      <hr class="rule-gold mb-8" />
      <p class="font-mono text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Tag
      </p>
      <h1 class="mt-2 font-mono text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {tag.name}
      </h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        {tag.items.length} {tag.items.length === 1 ? 'entry' : 'entries'}.
        <a href="/tags/" class="ml-1 text-accent-700 link-underline dark:text-accent-300">
          All tags
        </a>
      </p>
    </header>

    <ul class="divide-y divide-slate-200 border-t border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {
        tag.items.map((item) => (
          <li class="group relative py-8">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
              <FormattedDate date={item.date} class="font-mono text-xs" />
              {item.kind === 'review' && (
                <span class="font-mono text-xs uppercase tracking-wider">review</span>
              )}
              {item.draft && (
                <span class="rounded-full bg-gold-100 px-2 py-0.5 font-mono text-xs font-medium text-gold-900 dark:bg-gold-900/30 dark:text-gold-200">
                  draft
                </span>
              )}
            </div>

            <h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
              <a href={item.href} class="after:absolute after:inset-0">
                <span class="bg-gradient-to-r from-gold-400 to-accent-400 bg-[length:0%_2px] bg-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_2px]">
                  {item.title}
                </span>
              </a>
            </h2>

            <p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-400">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
