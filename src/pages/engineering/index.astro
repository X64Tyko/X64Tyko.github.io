---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPostsByArea, getSeriesMap } from '@/lib/posts';
import { trackById } from '@/data/tracks';

const track = trackById('engineering');
const posts = await getPostsByArea('engineering');

// Only surface series that actually hold engineering posts.
const series = [...(await getSeriesMap())].filter(([, list]) =>
  list.some((p) => p.data.area === 'engineering'),
);

const projects = (
  await getCollection(
    'projects',
    ({ data }) => (import.meta.env.DEV || !data.draft) && data.area === 'engineering',
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={track.label} description={track.blurb}>
  <div class="container-prose">
    <header class="pb-8">
      <hr class="rule-gold mb-8" />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {track.label}
      </h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-400">
        {track.blurb}
      </p>
      <p class="mt-4 text-sm">
        <a href="/engineering/rss.xml" class="text-accent-700 link-underline dark:text-accent-300">
          Engineering feed
        </a>
      </p>
    </header>

    {series.length > 0 && (
      <section class="border-t border-slate-200 pt-6 dark:border-slate-800">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Series
        </h2>
        <ul class="mt-4 space-y-3">
          {series.map(([name, list]) => (
            <li>
              <a
                href={`/series/${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}
                class="font-medium text-slate-900 link-underline dark:text-slate-100"
              >
                {name}
              </a>
              <span class="ml-2 font-mono text-xs text-slate-500 dark:text-slate-400">
                {list.length} {list.length === 1 ? 'post' : 'posts'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-10 border-t border-slate-200 pt-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Writing
      </h2>
      {posts.length === 0 ? (
        <p class="py-8 text-slate-500 dark:text-slate-400">Nothing published yet.</p>
      ) : (
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </section>

    {projects.length > 0 && (
      <section class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
        <div class="flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Projects
          </h2>
          <a href="/projects/" class="text-sm text-accent-700 link-underline dark:text-accent-300">
            All projects
          </a>
        </div>
        <ul class="mt-4 space-y-3">
          {projects.map(({ data }) => (
            <li>
              <span class="font-medium text-slate-900 dark:text-slate-100">{data.name}</span>
              <span class="ml-2 font-mono text-xs text-slate-500 dark:text-slate-400">
                {data.status}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
