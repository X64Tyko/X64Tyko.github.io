---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
  <div class="container-prose py-16 text-center">
    <p class="font-mono text-sm text-gold-600 dark:text-gold-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
      Page not found
    </h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      That page doesn't exist, or it moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-accent-600 px-4 py-2 text-sm font-medium
             text-white transition-colors hover:bg-accent-700"
    >
      Back home
    </a>
  </div>
</BaseLayout>
