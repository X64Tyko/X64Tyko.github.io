---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/Prose.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { getAllPosts, getSeriesContext } from '@/lib/posts';
import Comments from '@/components/Comments.astro';
import { slugify } from '@/lib/slug';

export const getStaticPaths = (async () => {
  // Drafts are built as unlisted pages: they carry `noindex`, stay out of the
  // blog index, RSS and sitemap, but remain reachable so that a cross-link
  // from one post to another doesn't 404 before both are published.
  const posts = await getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags, draft, canonicalUrl } = post.data;
const seriesCtx = await getSeriesContext(post);

// Only h2s make a useful outline; h3s nest too deep for a sidebar-less layout.
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={title}
  description={description}
  publishedDate={date}
  updatedDate={updated}
  noindex={draft}
>
  <article class="container-prose">
    <header class="pb-8">
      <hr class="rule-gold mb-8" />

      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
        <FormattedDate date={date} class="font-mono text-xs" />
        {updated && (
          <span class="font-mono text-xs">
            &middot; updated <FormattedDate date={updated} />
          </span>
        )}
        {draft && (
          <span
            class="rounded-full bg-gold-100 px-2 py-0.5 font-mono text-xs font-medium
                   text-gold-900 dark:bg-gold-900/30 dark:text-gold-200"
          >
            draft
          </span>
        )}
      </div>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        {title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {description}
      </p>

      {seriesCtx && (
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          {seriesCtx.subseries ? (
            <>
              Part {seriesCtx.subseries.part} of {seriesCtx.subseries.total} in{' '}
              <span class="font-medium text-slate-700 dark:text-slate-200">
                {seriesCtx.subseries.name}
              </span>
              , part of{' '}
              <a
                href={seriesCtx.href}
                class="font-medium text-accent-700 link-underline dark:text-accent-300"
              >
                {seriesCtx.name}
              </a>
            </>
          ) : (
            <>
              Part {seriesCtx.part} of {seriesCtx.total} in{' '}
              <a
                href={seriesCtx.href}
                class="font-medium text-accent-700 link-underline dark:text-accent-300"
              >
                {seriesCtx.name}
              </a>
            </>
          )}
        </p>
      )}

      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${slugify(tag)}/`} class="tag-chip hover:border-gold-500">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}

      {canonicalUrl && (
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
          Originally published at
          <a href={canonicalUrl} rel="canonical" class="link-underline">{canonicalUrl}</a>
        </p>
      )}
    </header>

    {toc.length > 2 && (
      <nav
        aria-label="Table of contents"
        class="mb-10 rounded-lg border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50"
      >
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Contents
        </h2>
        <ol class="mt-3 space-y-1.5 text-sm">
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-slate-600 link-underline dark:text-slate-400">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <Prose>
      <Content />
    </Prose>

    {post.data.comments && !draft && <Comments />}

    <footer class="mt-16 border-t border-slate-200 pt-8 dark:border-slate-800">
      {seriesCtx && (seriesCtx.prev || seriesCtx.next) && (
        <nav aria-label="Series" class="mb-8 grid gap-4 sm:grid-cols-2">
          {seriesCtx.prev && (
            <a
              href={`/blog/${seriesCtx.prev.id}/`}
              rel="prev"
              class="rounded-lg border border-slate-200 p-4 transition-colors
                     hover:border-gold-400 dark:border-slate-800 dark:hover:border-gold-500"
            >
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                Previous in series
              </span>
              <span class="mt-1 block font-medium text-slate-900 dark:text-slate-100">
                {seriesCtx.prev.data.title}
              </span>
            </a>
          )}
          {seriesCtx.next && (
            <a
              href={`/blog/${seriesCtx.next.id}/`}
              rel="next"
              class="rounded-lg border border-slate-200 p-4 transition-colors
                     hover:border-gold-400 sm:col-start-2 sm:text-right
                     dark:border-slate-800 dark:hover:border-gold-500"
            >
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
                Next in series
              </span>
              <span class="mt-1 block font-medium text-slate-900 dark:text-slate-100">
                {seriesCtx.next.data.title}
              </span>
            </a>
          )}
        </nav>
      )}

      <a href="/blog/" class="text-sm text-accent-700 link-underline dark:text-accent-300">
        &larr; All posts
      </a>
    </footer>
  </article>
</BaseLayout>
