---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, socials } from '@/data/site';
---

<BaseLayout title="Contact" description={`How to reach ${site.realName}.`}>
  <div class="container-prose">
    <header class="pb-8">
      <hr class="rule-gold mb-8" />
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
        Contact
      </h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        I'm {site.realName}. These are the best ways to reach me.
      </p>
    </header>

    <ul class="divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {site.email && (
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="font-mono text-sm text-slate-500 dark:text-slate-400">Email</span>
          <a href={`mailto:${site.email}`} class="text-accent-700 link-underline dark:text-accent-300">
            {site.email}
          </a>
        </li>
      )}
      {socials.map((s) => (
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="font-mono text-sm text-slate-500 dark:text-slate-400">{s.label}</span>
          <a
            href={s.href}
            rel="me noopener"
            class="break-all text-right text-accent-700 link-underline dark:text-accent-300"
          >
            {s.href.replace(/^https?:\/\//, '')}
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
      Posts are also available over
      <a href="/rss.xml" class="link-underline">RSS</a>.
    </p>
  </div>
</BaseLayout>
